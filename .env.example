# Server
SERVER_PORT=8080
SERVER_TIMEOUT_READ=3s
SERVER_TIMEOUT_WRITE=5s
SERVER_TIMEOUT_IDLE=5s
SERVER_DEBUG=true

# CORS — comma-separated allowed origins for the frontend. Optional;
# defaults to common localhost dev ports when unset.
# ALLOWED_ORIGINS=http://localhost:3000,https://klyvi.app

# Database (Supabase Postgres; pooler host shown as an example)
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASS=replace_me
DB_NAME=postgres
DB_SSLMODE=require
DB_DEBUG=true

# TMDB
TMDB_API_KEY=replace_me
TMDB_BASE_URL=https://api.themoviedb.org/3

# Supabase Auth
SUPABASE_JWKS_URL=https://your_project_ref.supabase.co/auth/v1/.well-known/jwks.json

# Supabase service-role features (optional). Enables the avatar upload
# endpoints and auth-user deletion. Server-side only — this key bypasses RLS
# and must never appear in any client bundle.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=avatars

# Recommender scoring weights (optional). Defaults are the values tuned by the
# leave-one-out harness — keyword overlap leads genre, which is the whole
# differentiator. Override only to retune; re-run cmd/reco-harness after.
# RECO_KEYWORD_WEIGHT=0.9
# RECO_GENRE_WEIGHT=0.2
# RECO_ERA_WEIGHT=0.1
# RECO_NEGATIVE_WEIGHT=0.6
# RECO_QUALITY_FLOOR=25
# Share of the feed kept for series, 0 to 1. Series get their own share of the
# candidate pool, since their vote counts run lower than films', and shows fill
# at most this share of a film lover's feed. 0 is a films-only feed and 1 a
# series-only one.
# RECO_TV_SHARE=0.4
# Holds the feed's genre mix near the mix of what the user likes. The cost per
# nat of KL divergence, scaled by the top score. 0 is off.
# RECO_CALIBRATION_WEIGHT=0
# Scores the Wikidata facts a title shares with what the user likes: directors,
# subjects, settings and source material, weighted by rarity. Needs the
# opendata job to have run. 0 is off.
# RECO_FACT_WEIGHT=0
# Scores the directors, writers, composers and show creators a title shares
# with what the user likes, weighted by rarity. 0 is off.
# RECO_CREW_WEIGHT=0
# Global IDF weighting of taste features — damps catalog-ubiquitous
# genres/keywords for a less repetitive feed. Off by default (offline sweep was
# a wash); needs seed-catalog -refresh-feature-stats to have run. A/B it live.
# RECO_USE_IDF=false
# How often the feed's in-memory catalog picks up changed titles. The feed
# draws its candidate pool from memory instead of the database. 0 turns it off
# and every feed reads the database.
# RECO_CATALOG_REFRESH=2m
