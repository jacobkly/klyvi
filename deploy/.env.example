# Klyvi API server config. Copy to `.env`, fill in, never commit the real one.
# Values without a leading `#` are required — the API won't boot if they're blank.

# HTTP server. SERVER_PORT must match the Cloudflare route (http://klyvi-api:8080).
SERVER_PORT=8080
SERVER_TIMEOUT_READ=3s
SERVER_TIMEOUT_WRITE=5s
SERVER_TIMEOUT_IDLE=5s
# Global per-IP rate limit on /v1 (optional; defaults shown).
# SERVER_RATELIMIT_RPM=120
# SERVER_RATELIMIT_BURST=40

# Your frontend origin(s), comma-separated. Without it the browser is CORS-blocked.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional. Supabase user ids (comma-separated) that may open /admin. Find
# yours in Supabase under Authentication, Users. Blank leaves the admin pages off.
# ADMIN_USER_IDS=

# Supabase Postgres — use the connection pooler host/port.
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASS=
DB_NAME=postgres
DB_SSLMODE=require

# Optional. nightly.sh pings this after a run where every step passed, so a
# failed or missing run raises an alarm (a free healthchecks.io check works).
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# TMDB v4 read access token.
TMDB_API_KEY=
# TMDB_BASE_URL=https://api.themoviedb.org/3

# Supabase JWT verification.
SUPABASE_JWKS_URL=https://your_project_ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your_project_ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Optional — enables avatar uploads and account deletion. Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars
